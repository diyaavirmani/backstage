      "l1",
      [
        "Great events start with an idea.",
        "Finding the right space takes coordination."
      ]
    ],
    [
      "l2",
      [
        "Meet Backstage.",
        "Describe your event, your audience,",
        "and the facilities you need."
      ]
    ],
    [
      "l3",
      [
        "Its agent queries a Sanity Knowledge Base",
        "for researched venue leads across Delhi NCR and Bengaluru."
      ]
    ],
    [
      "l4",
      [
        "See the sources, understand the qualifications,",
        "and know what still needs confirmation."
      ]
    ],
    [
      "l5",
      [
        "Create a private draft",
        "with your event brief and evidence kept together."
      ]
    ],
    [
      "l6",
      [
        "Explore a demo of host approvals,",
        "resource allocation, and preparation."
      ]
    ],
    [
      "l7",
      [
        "Backstage. Your next event starts here."
      ]
    ]
