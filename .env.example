# Public Sanity identifiers used by Studio configuration; they are not credentials.
NEXT_PUBLIC_SANITY_PROJECT_ID=replace-with-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=replace-with-sanity-dataset-name

# Server-only tokens. Never prefix these with NEXT_PUBLIC_ or commit their values.
# Use a project-scoped read-only token for hosted app reads. The write token is only for local seed imports.
SANITY_PROJECT_READ_TOKEN=replace-with-project-read-only-token
SANITY_PROJECT_IMPORT_TOKEN=replace-with-project-content-write-token
SANITY_CONTEXT_MCP_URL=https://replace-with-context-mcp-endpoint
SANITY_ORGANIZATION_TOKEN=replace-with-organization-context-viewer-token

# Server-side model credentials for organizer venue discovery. The UI and production build run without these.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Public canonical origin used to validate browser POST requests.
APP_ORIGIN=http://localhost:3000

# Persisted public-demo request limits (per UTC day).
DEMO_DISCOVERY_DAILY_PER_SESSION=5
DEMO_DISCOVERY_DAILY_GLOBAL=50

# Persistent operational SQLite database. Railway mounts its persistent volume at /data.
BACKSTAGE_DB_PATH=.data/backstage.sqlite
