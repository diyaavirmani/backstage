{
  "name": "backstage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "cp -R .next/static .next/standalone/.next/ && cp -R public .next/standalone/ && cd .next/standalone && node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sanity:validate": "node scripts/validate-catalog.mjs",
    "sanity:seed": "node scripts/seed-sanity.mjs",
    "sanity:seed:dry-run": "node scripts/seed-sanity.mjs --dry-run",
    "sanity:verify-seed": "node scripts/verify-seed.mjs",
    "sanity:context-check": "node scripts/sanity-context-check.mjs",
    "test:context-outline": "node --test scripts/context-outline.test.mjs scripts/context-citations.test.mjs",
    "test:agent": "node --test scripts/agent-input.test.mjs scripts/agent-validation.test.mjs scripts/agent-retrieval.test.mjs scripts/context-outline.test.mjs scripts/context-citations.test.mjs scripts/locality-scope.test.mjs",
    "test:operations": "node --test scripts/operations-store.test.mjs scripts/backend-startup-race.diagnostic.test.mjs",
    "test:deployment-controls": "node --test scripts/deployment-controls.test.mjs scripts/discovery-quota.test.mjs",
    "test:backend-api-qa": "playwright test tests/e2e/backend-api-qa.spec.ts",
    "test:backend-stress": "node scripts/backend-stress.mjs",
    "test:backend-operations-stress": "node scripts/backend-operations-stress.mjs",
    "test:provider-failures": "node --experimental-strip-types --test scripts/provider-failure-qa.test.mjs",
    "test:backend-startup-diagnostic": "node --test scripts/backend-startup-race.diagnostic.test.mjs",
    "test:backend-live-locality-diagnostic": "APP_ORIGIN=http://127.0.0.1:3107 BACKSTAGE_LIVE_LOCALITY_DIAGNOSTIC=1 node --import ./scripts/load-env.mjs ./node_modules/playwright/cli.js test tests/e2e/live-locality-diagnostic.spec.ts",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "verify:docker-image": "node scripts/verify-docker-image.mjs",
    "test:e2e": "npm run build && playwright test",
    "sanity:schema:validate": "sanity schemas validate --level error",
    "sanity:schema:deploy": "sanity schemas deploy",
    "sanity:dev": "sanity dev --host 127.0.0.1"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.66",
    "@ai-sdk/openai": "^4.0.83",
    "@sanity/client": "^8.9.0",
    "ai": "^7.0.127",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sanity/cli": "^8.13.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "railway": "^3.12.0",
    "sanity": "^6.17.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@module-federation/dts-plugin": "^2.9.2",
    "adm-zip": "^0.6.1",
    "undici": "^7.29.1",
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.0"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}
